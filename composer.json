        {
            "name": "Massimiliano Torromeo",
            "email": "massimiliano.torromeo@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/mtorromeo/php-ext-fpm-proctitle/issues",
        "source": "https://github.com/mtorromeo/php-ext-fpm-proctitle"
    },
    "require": {
